# Copy the settings you need into your Immich .env.

# CPU-only deployments use compose.qwen.cpu.yaml.
QWEN_GPU_ID=0
QWEN_ST_DEVICE=cuda
# auto selects BF16 on CUDA and FP32 on CPU.
QWEN_ST_DTYPE=auto
QWEN_ST_ATTENTION=sdpa
# OMP_NUM_THREADS=4
# MKL_NUM_THREADS=4

QWEN_ST_MODEL=Qwen/Qwen3-VL-Embedding-2B
# Empty uses the built-in pinned revision for the default model.
QWEN_ST_REVISION=
# Keep the alias and dimension consistent with Immich's Smart Search index.
QWEN_ST_MODEL_NAME=sentence-qwen3-vl-embedding-2b/ViT-B-32__openai
QWEN_ST_DIMENSION=512
QWEN_ST_QUERY_PROMPT="Retrieve images that match the given text."
QWEN_ST_IMAGE_PROMPT="Represent the user's input."

QWEN_ST_IMAGE_MAX_EDGE=768
QWEN_ST_IMAGE_MAX_PIXELS=80000000
QWEN_ST_MAX_BODY_MIB=64

# Empty uses the named Docker volume. A host path must point to the cache root.
QWEN_MODEL_CACHE=
HF_HUB_OFFLINE=0
HF_HUB_DOWNLOAD_TIMEOUT=10
HF_HUB_ETAG_TIMEOUT=10

# Seconds. Zero disables unloading or the inference deadline.
QWEN_ST_IDLE_SECONDS=600
QWEN_ST_INFERENCE_TIMEOUT=0
IMMICH_ML_URL=http://immich-machine-learning:3003
IMMICH_ML_TIMEOUT=120
IMMICH_ML_CONNECT_TIMEOUT=3
IMMICH_ML_HEALTH_TIMEOUT=2
UVICORN_TIMEOUT_KEEP_ALIVE=5
# UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN=30
UVICORN_LOG_LEVEL=info
QWEN_HEALTHCHECK_INTERVAL=30s
QWEN_HEALTHCHECK_TIMEOUT=5s
